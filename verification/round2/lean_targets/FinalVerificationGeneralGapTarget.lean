import Mathlib
import domination_gap3.GraphConnectionTheoremCandidate

/-! Fixed target for Theorem 1.2 (label thm:criterion-intro) of the submitted
manuscript (GC PDF sha256 4df950b6...), for general h, written 2026-11-13.

Paper statement: F a forest of order n, h = Γ(F) - γ(F), K_h = ⌈(h+1)²/4⌉.
(i)   n - γ ≥ 3K_h - 7 implies D(F,x) unimodal.
(ii)  F without isolated vertices and D(F,x) not unimodal imply h ≥ 3 and
      n ≤ 6K_h - h - 16.
(iii) F without isolated vertices and 3h² + 4h - 19 ≤ 2n imply unimodal.

Correspondence notes.
* γ is pinned by S0 (a dominating set with at most γ elements) and hγmin;
  Γ = γ + h is pinned by M (a minimal dominating set with γ + h elements)
  and hΓmax.  This is the convention of Appendix B of the paper.
* All inequalities are written without natural-number subtraction:
  n - γ ≥ 3K - 7 is γ + 3K ≤ n + 7; n ≤ 6K - h - 16 is n + h + 16 ≤ 6K;
  3h² + 4h - 19 ≤ 2n is 3h² + 4h ≤ 2n + 19.
* `K h = ((h+1)^2 + 3) / 4` with natural division; `K_spec` states that
  this is the ceiling of (h+1)²/4.
* Unimodality is the statement used throughout the existing development:
  ∃ m, nondecreasing below m and nonincreasing from m on, for the sequence
  dR G.Adj k (= d_k as a real number, 0 for k > n).
* [Nonempty α] encodes n ≥ 1 (Theorem 5.1 of the paper assumes n ≥ 1).

Do not edit this file.  Proofs go to FinalVerificationGeneralGapCandidate.lean. -/

namespace FinalVerificationGeneralGap
open GapThreeGraphConnectionAudit

def K (h : ℕ) : ℕ := ((h + 1) ^ 2 + 3) / 4

theorem K_spec (h : ℕ) : (h + 1) ^ 2 ≤ 4 * K h ∧ 4 * K h < (h + 1) ^ 2 + 4 := by
  sorry

/-- The values quoted in the paper: K_0 = K_1 = 1, K_2 = 3, K_3 = 4, K_4 = 7,
K_5 = 9, and the bound 6K_h - h - 16 equals 5, 22, 33 for h = 3, 4, 5. -/
theorem K_values :
    K 0 = 1 ∧ K 1 = 1 ∧ K 2 = 3 ∧ K 3 = 4 ∧ K 4 = 7 ∧ K 5 = 9 ∧
    6 * K 3 = 5 + 3 + 16 ∧ 6 * K 4 = 22 + 4 + 16 ∧ 6 * K 5 = 33 + 5 + 16 := by
  sorry

/-- Theorem 1.2(i). -/
theorem forest_unimodal_of_large
    {α : Type*} [Fintype α] [DecidableEq α] [Nonempty α]
    (G : SimpleGraph α) [DecidablePred (IsDominating G.Adj)]
    (hforest : G.IsAcyclic)
    (γ h : ℕ) (S0 M : Finset α)
    (hS0 : IsDominating G.Adj S0) (hS0card : S0.card ≤ γ)
    (hγmin : ∀ S : Finset α, IsDominating G.Adj S → γ ≤ S.card)
    (hM : IsDominating G.Adj M)
    (hMminimal : ∀ x ∈ M, ¬ IsDominating G.Adj (M.erase x))
    (hMcard : M.card = γ + h)
    (hΓmax : ∀ N : Finset α, IsDominating G.Adj N →
      (∀ x ∈ N, ¬ IsDominating G.Adj (N.erase x)) → N.card ≤ γ + h)
    (hlarge : γ + 3 * K h ≤ Fintype.card α + 7) :
    ∃ m : ℕ, (∀ k < m, dR G.Adj k ≤ dR G.Adj (k + 1)) ∧
      (∀ k ≥ m, dR G.Adj (k + 1) ≤ dR G.Adj k) := by
  sorry

/-- Theorem 1.2(ii). -/
theorem forest_not_unimodal_bound
    {α : Type*} [Fintype α] [DecidableEq α] [Nonempty α]
    (G : SimpleGraph α) [DecidablePred (IsDominating G.Adj)]
    (hforest : G.IsAcyclic) (hnoisolates : ∀ v, ∃ u, G.Adj v u)
    (γ h : ℕ) (S0 M : Finset α)
    (hS0 : IsDominating G.Adj S0) (hS0card : S0.card ≤ γ)
    (hγmin : ∀ S : Finset α, IsDominating G.Adj S → γ ≤ S.card)
    (hM : IsDominating G.Adj M)
    (hMminimal : ∀ x ∈ M, ¬ IsDominating G.Adj (M.erase x))
    (hMcard : M.card = γ + h)
    (hΓmax : ∀ N : Finset α, IsDominating G.Adj N →
      (∀ x ∈ N, ¬ IsDominating G.Adj (N.erase x)) → N.card ≤ γ + h)
    (hnot : ¬ ∃ m : ℕ, (∀ k < m, dR G.Adj k ≤ dR G.Adj (k + 1)) ∧
      (∀ k ≥ m, dR G.Adj (k + 1) ≤ dR G.Adj k)) :
    3 ≤ h ∧ Fintype.card α + h + 16 ≤ 6 * K h := by
  sorry

/-- Theorem 1.2(iii). -/
theorem forest_unimodal_of_quadratic
    {α : Type*} [Fintype α] [DecidableEq α] [Nonempty α]
    (G : SimpleGraph α) [DecidablePred (IsDominating G.Adj)]
    (hforest : G.IsAcyclic) (hnoisolates : ∀ v, ∃ u, G.Adj v u)
    (γ h : ℕ) (S0 M : Finset α)
    (hS0 : IsDominating G.Adj S0) (hS0card : S0.card ≤ γ)
    (hγmin : ∀ S : Finset α, IsDominating G.Adj S → γ ≤ S.card)
    (hM : IsDominating G.Adj M)
    (hMminimal : ∀ x ∈ M, ¬ IsDominating G.Adj (M.erase x))
    (hMcard : M.card = γ + h)
    (hΓmax : ∀ N : Finset α, IsDominating G.Adj N →
      (∀ x ∈ N, ¬ IsDominating G.Adj (N.erase x)) → N.card ≤ γ + h)
    (hquad : 3 * h ^ 2 + 4 * h ≤ 2 * Fintype.card α + 19) :
    ∃ m : ℕ, (∀ k < m, dR G.Adj k ≤ dR G.Adj (k + 1)) ∧
      (∀ k ≥ m, dR G.Adj (k + 1) ≤ dR G.Adj k) := by
  sorry

end FinalVerificationGeneralGap
